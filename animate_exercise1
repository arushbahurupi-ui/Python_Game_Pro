import pygame

pygame.init()

screen = pygame.display.set_mode((1600,800))
background = pygame.image.load("images/images-2.jpeg")
background = pygame.transform.scale(background, (1600,800))

flower = pygame.image.load("images/flower.png")
flower = pygame.transform.scale(flower, (100,100))


y_f =-100
y_f2 = 800
x_f = -100
x_f2 = 1600



def animation ():
    global y_f, y_f2, x_f, x_f2
    for i in range(16):
        screen.blit(flower, (0 + i * 100, y_f))
    y_f += 8

    for i in range(16):
        screen.blit(flower, (0 + i * 100, y_f2))
    y_f2 -= 8
    for i in range(8):
        screen.blit(flower, (x_f, 0 + i * 100))
    x_f += 16
    for i in range(8):
        screen.blit(flower, (x_f2, 0 + i * 100))
    x_f2 -=16




while True:
    screen.blit(background, (0, 0))
    screen.fill("pink")

    animation()
    if x_f >= 1600:
        y_f = -100
        y_f2 = 800
        x_f = -100
        x_f2 = 1600

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            pygame.quit()
    pygame.display.update()
